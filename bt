        if len(args) > 1:
            result = " ".join(args[1:])
        else:
            print(f"No hay resultado pendiente para {tid}.")
            print("Usa: bt finalize <id> \"resultado\" para forzar cierre.")
            return

    _finalize_task(tid, result)
    write_inbox(tid, f"[bt/finalize] tu tarea fue aprobada y cerrada.\nResultado: {result}")

def cmd_schedule(args):
    """bt schedule "titulo" "YYYY-MM-DD HH:MM" [--owner X] [--workspace X] [--desc "..."]"""
    if len(args) < 2:
        return print('Uso: bt schedule "titulo" "YYYY-MM-DD HH:MM" [--owner X] [--workspace X] [--agent X] [--desc "descripcion"]')
    title = args[0]
    scheduled_at = args[1]
    try:
        datetime.strptime(scheduled_at, "%Y-%m-%d %H:%M")
    except ValueError:
        return print(f"Formato de fecha inválido: {scheduled_at!r} — usa YYYY-MM-DD HH:MM")

    owner, priority, workspace, desc = "claude", "medium", "", ""
    i = 2
    while i < len(args):
        if args[i] in ("--owner", "--agent") and i+1 < len(args): owner = args[i+1]; i += 2
        elif args[i] == "--priority" and i+1 < len(args):          priority  = args[i+1]; i += 2
        elif args[i] == "--workspace" and i+1 < len(args):         workspace = args[i+1]; i += 2
        elif args[i] == "--desc"      and i+1 < len(args):         desc      = args[i+1]; i += 2
        else: i += 1

    ensure_board_layout()
    tid = make_id(title)
    create_task_file(tid, title, owner, priority, workspace, desc, scheduled_at=scheduled_at)
    lines = BOARD_FILE.read_text().splitlines()
    lines = add_row(lines, S_PROGRAMADAS, [tid, title, owner, scheduled_at, workspace or "—"])
    BOARD_FILE.write_text("\n".join(lines) + "\n")
    print(f"✓ programada: {tid} → {scheduled_at}")

def cmd_revisar(args):
