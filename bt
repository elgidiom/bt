        print("Uso: bt session request|approve|reject|close|msg|ls ...")
        print("  bt session request <desde> <hacia> \"motivo\"")
        print("  bt session approve <mi_tarea> <otra_tarea>")
        print("  bt session reject <mi_tarea> <otra_tarea> \"motivo\"")
        print("  bt session close <mi_tarea> <otra_tarea> \"motivo\"")
        print("  bt session msg <desde> <hacia> \"mensaje\"")
        print("  bt session ls [<task>]")
        return

    sub = args[0].lower()

    if sub == "request":
        if len(args) < 4:
            return print('Uso: bt session request <desde> <hacia> "motivo"')
        from_task, to_task = resolve_task_pair(args[1], args[2])
        if not from_task:
            return
        reason = " ".join(args[3:]).strip()
        data = read_sessions()
        session = upsert_session(data, from_task, to_task)
        if session.get("status") == "active":
            return print(f"Ya existe una sesión activa entre {from_task} y {to_task}.")
        if session.get("status") == "pending" and session.get("requested_by") == to_task:
            return print(
                f"{to_task} ya te solicitó conexión. Apruébala con: bt session approve {from_task} {to_task}"
            )
        session.update({
            "status": "pending",
            "requested_by": from_task,
            "requested_to": to_task,
            "requested_at": now(),
            "reason": reason,
        })
        session.pop("approved_by", None)
        session.pop("approved_at", None)
        session.pop("rejected_by", None)
        session.pop("rejected_at", None)
        session.pop("reject_reason", None)
        session.pop("closed_by", None)
        session.pop("closed_at", None)
        session.pop("close_reason", None)
        add_session_event(session, "requested", from_task, reason)
        write_sessions(data)
        task_append_progress(from_task, f"solicitud de sesión enviada a {to_task}: {reason}")
        task_append_progress(to_task, f"{from_task} solicita sesión compartida: {reason}")
        delivered, detail = notify_task_terminal(
            to_task,
            f"[bt/session] {from_task} solicita conexión con {to_task}. Motivo: {reason}. "
            f"Aprobar: bt session approve {to_task} {from_task}. "
            f"Rechazar: bt session reject {to_task} {from_task} <motivo>"
        )
        print(f"✓ sesión solicitada: {from_task} → {to_task}")
        if delivered:
            print(f"  Notificación enviada a la terminal de {to_task} (tmux:{detail}).")
        else:
            print(f"  No se pudo notificar en vivo a {to_task}: {detail}")
        return

    if sub == "approve":
